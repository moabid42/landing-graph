{
  "name": "landing-graph",
  "private": true,
  "version": "1.0.1",
  "description": "A personal site that renders a career as a git graph. Mine, and a template to fork.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "prepare": "husky",
    "size": "node scripts/check-bundle.js",
    "audit": "npm audit",
    "lighthouse": "node scripts/lighthouse.js",
    "og": "node scripts/og-image.js"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "keywords": [
    "portfolio",
    "personal-site",
    "template",
    "react",
    "vite",
    "git-graph",
    "timeline",
    "resume"
  ],
  "author": "moabid42",
  "homepage": "https://github.com/moabid42/landing-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabid42/landing-graph.git"
  },
  "bugs": {
    "url": "https://github.com/moabid42/landing-graph/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
